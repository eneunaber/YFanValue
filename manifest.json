{
    "name": "Yahoo Player Values",
    "description": "Extension to display player values in dollar amounts on Yahoo Fantasy pages",
    "version": "0.1",
    "manifest_version": 3,
    "options_page": "src/options/options.html",
    "background": {
        "service_worker": "src/background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://baseball.fantasysports.yahoo.com/b1/*"
            ],
            "js": [
                "src/content/playerValue.js"
            ]
        }
    ],
    "host_permissions": [
        "https://prod-elneunie-fantasybaseballleaguestats.s3.us-east-2.amazonaws.com/*",
        "https://*/*",
        "http://localhost/*"
    ],
    "permissions": [
        "storage"
    ]
}
