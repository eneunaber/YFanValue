{
  "name": "yfan-value",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security": "npm run security:dependencies && npm run security:signatures && npm run security:secrets && npm run security:code",
    "security:dependencies": "npm audit --audit-level=moderate",
    "security:signatures": "npm audit signatures",
    "security:secrets": "gitleaks git --redact .",
    "security:code": "semgrep scan --config auto ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
